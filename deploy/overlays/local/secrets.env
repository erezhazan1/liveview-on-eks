# LOCAL KIND DEV ONLY - not real secrets, safe to commit.
# In GovCloud/prod these come from AWS Secrets Manager via the External Secrets Operator
# or the Secrets Store CSI driver (see deploy/overlays/govcloud-prod), never from a file.
# SECRET_KEY_BASE just needs to be >= 64 chars for Phoenix to boot; this obvious filler
# value is deliberately not entropy so nobody mistakes it for a leaked production key.
DATABASE_URL=ecto://postgres:postgres@postgres.demo.svc.cluster.local/demo_prod
SECRET_KEY_BASE=local-kind-dev-only-not-a-real-secret-regenerate-for-any-real-use-0000
