# Production config for the govcloud-prod overlay.
#
# CHECK_ORIGIN is deliberately NOT set here (contrast with the local overlay,
# which sets CHECK_ORIGIN=false to disable origin checking for kind's
# http://localhost access). With CHECK_ORIGIN unset, config/runtime.exs
# (Task 1) defaults check_origin to ["https://#{PHX_HOST}"] - the secure,
# same-origin default. Production should use that default, not disable it.
PHX_SERVER=true
# PHX_HOST is a documented placeholder domain - replace with the real
# GovCloud-hosted DNS name at deploy time (also drives the CHECK_ORIGIN
# default above, since check_origin becomes ["https://<PHX_HOST>"]).
PHX_HOST=app.example.gov
PORT=4000
POOL_SIZE=10
RELEASE_TMP=/tmp
